# ==============================================================================
# TOPX (gettopx.lol) — SUPABASE & POLAR.SH ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# In your Supabase Dashboard -> Project Settings -> Database -> Connection String:

# A) Transaction Pooler (Port 6543 - for Serverless / Vercel production):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# B) Direct Connection (Port 5432 - for Prisma Migrations / CLI):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://gettopx.lol"
ADMIN_SECRET_KEY="supersecretadmin123"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. PAYMENT PROVIDER: POLAR.SH (EXCLUSIVE)
# ------------------------------------------------------------------------------
# Get your API credentials at: https://polar.sh/dashboard/settings
# Webhook URL to register in Polar Dashboard: https://gettopx.lol/api/webhook/payment
POLAR_ACCESS_TOKEN="polar_at_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
POLAR_ORGANIZATION_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
POLAR_WEBHOOK_SECRET="polar_wh_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
